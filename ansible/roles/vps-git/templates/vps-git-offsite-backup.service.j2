# Managed by Ansible -- do not edit manually.
[Unit]
Description=vps-git offsite backup to R2 with restic (serving primary only)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# restic needs a home or cache dir; systemd services have neither by default.
Environment=HOME=/root
Environment=XDG_CACHE_HOME=/var/cache/vps-git-restic
ExecStart={{ vps_git_dir }}/stack/offsite-backup.sh
