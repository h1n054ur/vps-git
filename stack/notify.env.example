# Discord webhook for vps-git notifications (backups, fence decisions).
# Copy to /etc/vps-git-backup/notify.env on each node, mode 600, owned by root.
# Never commit the real URL: anyone who has it can post to the channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Message id of the live status card (stack/status-card.sh --create prints it)
STATUS_MESSAGE_ID=
