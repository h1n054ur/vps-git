# vps-git -- copy to stack/.env and fill in real values.
# Ansible does this automatically during deploy.

# Role: "primary" or "standby"
ROLE=primary
COMPOSE_PROFILES=primary

# App
APP_NAME=vps-git
APP_URL=https://git.example.com
FORGE_IMAGE=codeberg.org/forgejo/forgejo:16

# Postgres
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=CHANGEME
REPL_USER=replicator
REPL_PASSWORD=CHANGEME

# Network
# Bind Postgres to THIS node's Tailscale IP so the peer (replication) and the
# watchdog (monitoring) can reach it, and nothing else can. Avoid 0.0.0.0:
# Docker port publishing bypasses ufw, so 0.0.0.0 is reachable from anywhere
# your provider firewall allows.
PG_BIND=100.x.x.x

# The Tailscale IP of the OTHER node (peer).
# Primary: set to standby IP.  Standby: set to primary IP.
PEER_HOST=

# Optional: the watchdog's public status page (Uptime Kuma behind its tunnel). The
# live status card shows it, and status-card.sh posts one alert when it becomes
# unreachable (Kuma alerts would be silent) and one when it recovers. Empty = skip.
WATCHDOG_URL=

# Backup -- how often (in seconds) the sidecar runs pg_dump + rsync to standby.
# This controls the RPO for Forgejo git data on disk (repos, LFS, attachments).
# Database changes replicate in real-time via Postgres streaming replication
# regardless of this value.
#   60   = every minute  (minimal data loss, slightly more I/O)
#   300  = every 5 min   (good balance)
#   900  = every 15 min  (default, lighter on resources)
BACKUP_INTERVAL=60
BACKUP_SSH_KEY=/root/.ssh/id_ed25519

# Cloudflare email sending (SMTP)
# Sender domain must be onboarded for Email Sending (subdomains onboard separately)
MAIL_FROM=noreply@example.com
CF_API_TOKEN=CHANGEME

# Forgejo security
FORGEJO_DISABLE_REGISTRATION=true
FORGEJO_REQUIRE_SIGNIN_VIEW=true
FORGEJO_DEFAULT_PRIVATE=private
