# vps-git -- copy to stack/.env and fill in real values.
# Ansible does this automatically during deploy.

# App
APP_NAME=vps-git
APP_URL=https://git.example.com
FORGE_IMAGE=codeberg.org/forgejo/forgejo:16

# Postgres
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=CHANGEME

# Network
# Bind Postgres to this node's Tailscale IP so the watchdog (monitoring) can
# reach it, and nothing else can. Avoid 0.0.0.0:
# Docker port publishing bypasses ufw, so 0.0.0.0 is reachable from anywhere
# your provider firewall allows.
PG_BIND=100.x.x.x

# Optional: the watchdog's Uptime Kuma URL (over the tailnet). The live status
# card shows it, and status-card.sh posts one alert when it becomes
# unreachable (Kuma alerts would be silent) and one when it recovers. Empty = skip.
WATCHDOG_URL=
# Optional: Uptime Kuma link for the card's button. Empty = no button.
STATUS_URL=

# Cloudflare email sending (SMTP)
# Sender domain must be onboarded for Email Sending (subdomains onboard separately)
MAIL_FROM=noreply@example.com
CF_API_TOKEN=CHANGEME

# Forgejo security
FORGEJO_DISABLE_REGISTRATION=true
FORGEJO_REQUIRE_SIGNIN_VIEW=true
FORGEJO_DEFAULT_PRIVATE=private
