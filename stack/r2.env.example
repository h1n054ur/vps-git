# Offsite backup target for stack/offsite-backup.sh (restic over the S3 API).
# Copy to /etc/vps-git-backup/r2.env on each node (root, mode 600). Never commit it.
#
# Cloudflare R2: create a bucket, then an R2 API token with "Object Read & Write"
# scoped to that bucket only. Any S3-compatible store works the same way.

# s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/forgejo-backups
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
AWS_DEFAULT_REGION=auto
